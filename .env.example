# Campus Pulse — Root Environment Configuration Template
# For Docker Compose and Local Development

# Database Engine: 'postgres' or 'sqlite'
DB_ENGINE=postgres

# PostgreSQL Connection Credentials
POSTGRES_USER=campuspulse_user
POSTGRES_PASSWORD=campuspulse_secure_password
POSTGRES_DB=campuspulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://campuspulse_user:campuspulse_secure_password@localhost:5432/campuspulse

# Connection Pooling
DB_POOL_MIN=2
DB_POOL_MAX=20

# SQLite File (Fallback)
DATABASE_PATH=Backend/storage/campus_pulse.db

# Server & Security
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000
