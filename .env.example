# Campus Pulse — Root Environment Configuration Template
# For Docker Compose and Local Development

# Database Engine: 'postgres' or 'sqlite'
DB_ENGINE=postgres

# PostgreSQL Connection Credentials
POSTGRES_USER=campuspulse_user
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=campuspulse
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://campuspulse_user:change_this_to_a_secure_password@127.0.0.1:5432/campuspulse

# Connection Pooling
DB_POOL_MIN=2
DB_POOL_MAX=20

# SQLite File (Fallback)
DATABASE_PATH=storage/campus_pulse.db

# Server & Security
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000

# Email Delivery Mode (development only, never true in production)
USE_LOCAL_EMAIL=false

# Category Priority Customization (feature flag: enables per-department and per-location category priorities and badges)
CATEGORY_PRIORITY_ENABLED=false

# Administrative Seed Credentials (FAIL CLOSED: required for account creation)
ADMIN_EMAIL=
ADMIN_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=


