# Backend Environment Configuration Template
DATABASE_PATH=storage/campus_pulse.db
SESSION_EXPIRE_HOURS=8
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# SMTP Email Configuration (Optional - fallback to console simulation if omitted)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@campuspulse.edu
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@campuspulse.edu

# With ENVIRONMENT=production no demo accounts are seeded. Create the initial
# accounts by supplying passwords, e.g. SEED_USR_ADMIN_PASSWORD (also
# SEED_USR_SUPER_ADMIN_PASSWORD); accounts without one are skipped.
# SEED_USR_ADMIN_PASSWORD=
