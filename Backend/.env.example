# Campus Pulse — Environment Configuration Template
# Configure active database engine, connection credentials, and system settings.

# ==============================================================================
# Database Configuration
# ==============================================================================
# Set DB_ENGINE to 'postgres' for PostgreSQL mode, or 'sqlite' for local file-based mode.
DB_ENGINE=postgres

# PostgreSQL Connection Details (Used when DB_ENGINE=postgres)
# Option A: Full Connection URL
DATABASE_URL=postgresql://campuspulse_user:campuspulse_secure_password@localhost:5432/campuspulse

# Option B: Individual Connection Parameters
POSTGRES_USER=campuspulse_user
POSTGRES_PASSWORD=campuspulse_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campuspulse

# PostgreSQL Connection Pool Parameters
DB_POOL_MIN=2
DB_POOL_MAX=20

# SQLite Fallback Configuration (Used when DB_ENGINE=sqlite or PostgreSQL is unconfigured)
DATABASE_PATH=storage/campus_pulse.db

# ==============================================================================
# Server & Security Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
SESSION_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RELOAD=false

# ==============================================================================
# SMTP Email Configuration (Optional - fallback to console simulation if omitted)
# ==============================================================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@campuspulse.edu
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@campuspulse.edu
# FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Initial Seed Passwords (For clean production bootstrap)
# ==============================================================================
# With ENVIRONMENT=production no demo accounts are seeded.
# Supply initial passwords to seed administrator accounts:
# SEED_USR_ADMIN_PASSWORD=
# SEED_USR_SUPER_ADMIN_PASSWORD=

# ==============================================================================
# Web Push Notifications (Optional - generate using python scripts/generate_vapid_keys.py)
# ==============================================================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@campuspulse.edu
